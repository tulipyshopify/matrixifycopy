// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  // Local dev: DATABASE_URL="file:dev.sqlite" in .env. Docker sets its own.
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// An import or export run.
model Job {
  id          String    @id @default(cuid())
  shop        String
  type        String // "export" | "import"
  status      String    @default("queued") // queued | running | finished | failed | cancelled
  /// JSON: export -> [{ entity, options }], import -> { options }
  config      String
  format      String    @default("xlsx")
  name        String    @default("")
  inputFile   String?
  inputName   String?
  resultFile  String?
  progress    Int       @default(0)
  total       Int       @default(0)
  /// JSON summary per sheet/entity
  stats       String    @default("[]")
  log         String    @default("")
  error       String?
  cancelRequested Boolean @default(false)
  /// Times the worker started this job (restarts re-queue exports).
  attempts    Int       @default(0)
  scheduleId  String?
  /// Rows that failed, plus rows of sheets that couldn't be imported (finished jobs).
  problems    Int       @default(0)
  /// When someone opened the job after it failed or finished with problems.
  reviewedAt  DateTime?
  /// "job" (export/import someone set up) or "backup" (a store backup).
  kind        String    @default("job")
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([shop, createdAt])
  @@index([status, createdAt])
}

/// A recurring export, or an import pulled from a URL/FTP source.
model Schedule {
  id              String    @id @default(cuid())
  shop            String
  name            String
  type            String // "export" | "import"
  config          String
  format          String    @default("xlsx")
  /// import: http(s):// or ftp:// URL of the file to import
  sourceUrl       String?
  /// export: optional ftp:// URL to upload the result to
  uploadUrl       String?
  intervalMinutes Int
  /// Daily / weekly schedules: local time of day ("07:30"), IANA time zone and,
  /// for weekly, the weekday (0 = Sunday). Null = every interval from the start.
  runAt           String?
  timezone        String?
  weekday         Int?
  nextRunAt       DateTime
  enabled         Boolean   @default(true)
  lastJobId       String?
  /// export: secret token of the permanent link that serves the latest result
  publicToken     String?   @unique
  linkDownloads   Int       @default(0)
  lastDownloadAt  DateTime?
  /// "job", or "backup" for the store's backup schedule (one per store).
  kind            String    @default("job")
  createdAt       DateTime  @default(now())

  @@index([enabled, nextRunAt])
}

/// A saved export set-up (data types, filters, columns, format).
model Preset {
  id        String   @id @default(cuid())
  shop      String
  name      String
  /// JSON: { entities: [{ entity, options }], format }
  config    String
  /// The staff member it belongs to ("" = everyone in the store, as before presets were per person).
  userId    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, userId, name])
}

/// Per-store settings.
model ShopSetting {
  shop        String   @id
  /// Days backups are kept (the newest is always kept).
  backupKeepDays Int   @default(30)
  /// Data check: products with any of these tags (comma separated) are left out.
  checkExcludeTags String @default("")
  /// Where job problems are also posted (a Slack or Teams incoming-webhook URL), sealed.
  alertWebhook String?
  /// Imports stop when more than this share (percent) of rows fail unexpectedly; 0 = never.
  failStopPercent Int @default(5)
  /// When an import is stopped for failing rows, put back what it had changed.
  undoOnStop Boolean @default(false)
  /// Google Drive, for backup copies: the sealed refresh token and the folder it uploads to.
  driveToken String?
  driveFolder String?
  /// Days exports stay in the job history.
  historyDays Int @default(90)
  /// Where alerts are also emailed (comma separated).
  alertEmails String @default("")
  /// S3-compatible storage for backup copies: JSON, sealed.
  backupBucket String?
  /// Saved ways of reading other people's files: which of their columns is which of ours (JSON list).
  columnLayouts String @default("[]")
  /// Shopify user numbers of the people who may create full access keys (comma separated); empty = anyone who can open the app.
  keyAdmins String @default("")
  /// Product images are meant to be square: note the ones that are not.
  squareImages Boolean @default(false)
  updatedAt   DateTime @updatedAt
}

/// What an import changed on one item, kept to answer "what changed this product, and when".
model ChangeLog {
  id        String   @id @default(cuid())
  shop      String
  jobId     String
  entity    String
  /// How the file named the item ("Handle=blue-shirt", "ID=123").
  itemKey   String
  /// The item's Shopify ID (numbers only), when the import reported it.
  itemId    String   @default("")
  title     String   @default("")
  action    String   @default("update")
  /// The change lines of the preview ("Title: old → new"), JSON.
  changes   String   @default("[]")
  createdAt DateTime @default(now())

  @@index([shop, itemKey])
  @@index([shop, itemId])
  @@index([shop, createdAt])
  @@index([jobId])
}

/// Plain-English requests ("Ask Bulkport") and the plan each became.
model AskLog {
  id        String   @id @default(cuid())
  shop      String
  prompt    String
  /// "export" | "change" | "unclear" | "error"
  kind      String
  /// JSON: the checked plan (export set-up or change), or the error message.
  result    String
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

/// An access key for the API, the MCP server, the CLI and the Sheets add-on.
/// Only a hash of the key is stored; the key itself is shown once.
model ApiKey {
  id         String    @id @default(cuid())
  shop       String
  name       String
  /// First characters of the key, to tell keys apart in the list.
  prefix     String
  hash       String    @unique
  /// May run imports for real (otherwise previews only).
  canImport  Boolean   @default(false)
  /// Exports and reading only: no import previews either.
  readOnly   Boolean   @default(false)
  /// Data types this key is limited to (comma separated keys); null = all.
  entities   String?
  /// Who made the key (a staff member's name or number, or the assistant that signed in).
  createdBy  String    @default("")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([shop])
}

/// A connection an assistant (an MCP client) is asking for, or has been given, through OAuth.
model OAuthGrant {
  id            String    @id @default(cuid())
  clientId      String
  redirectUri   String
  /// PKCE challenge (S256) of the request.
  challenge     String
  state         String    @default("")
  /// The short code the merchant types in the app to approve it.
  userCode      String    @unique
  shop          String?
  approvedAt    DateTime?
  /// SHA-256 of the one-time authorization code, once issued.
  codeHash      String?   @unique
  codeUsedAt    DateTime?
  /// SHA-256 of the current refresh token.
  refreshHash   String?   @unique
  /// The access key in use for this connection.
  keyId         String?
  clientName    String    @default("")
  createdAt     DateTime  @default(now())

  @@index([shop])
}

/// An MCP client that registered itself (OAuth dynamic client registration).
model OAuthClient {
  id           String   @id @default(cuid())
  name         String   @default("")
  /// JSON array of allowed redirect URIs.
  redirectUris String
  createdAt    DateTime @default(now())
}
