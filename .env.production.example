# Copy to .env.production on the server and fill in. Never commit the real file.

# From the Partner Dashboard (Apps > your app > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS address of this server, no trailing slash
SHOPIFY_APP_URL=https://bulkport.example.com

# Must match [access_scopes] in shopify.app.toml
SCOPES=write_products,write_inventory,read_locations,write_publications,write_customers,write_orders,read_all_orders,write_draft_orders,write_discounts,read_shopify_payments_payouts,write_content,write_online_store_pages,write_online_store_navigation,write_files,write_metaobjects,read_metaobject_definitions

# Optional
FILE_RETENTION_DAYS=30
MAX_UPLOAD_MB=200
