# Copy to .env.production on the server and fill in. Never commit the real file.

# From the Partner Dashboard (Apps > your app > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS address of this server, no trailing slash
SHOPIFY_APP_URL=https://bulk.tulipy.app

# Must match [access_scopes] in shopify.app.toml
SCOPES=write_products,write_inventory,read_locations,write_publications,write_customers,write_orders,read_all_orders,write_draft_orders,write_discounts,read_shopify_payments_payouts,write_content,write_online_store_pages,write_online_store_navigation,write_files,write_metaobjects,read_metaobject_definitions

# Optional
FILE_RETENTION_DAYS=30
# Days an export stays in the history before it and its file are cleared (0 = keep)
EXPORT_HISTORY_DAYS=7
MAX_UPLOAD_MB=200

# Store backups (Backups page). "*" = every store on this server; or a list of
# myshopify.com domains, separated by commas. Empty = nobody (shows the paid-plan note).
BACKUP_SHOPS=*

# "Ask Bulkport" (plain-English exports and changes). Uses the Claude API: each
# request costs a little. Without a key the box is hidden.
# ANTHROPIC_API_KEY=sk-ant-...
# Stores allowed to use it: "*" for all, or myshopify.com domains separated by commas.
ASSIST_SHOPS=*

# API / MCP / CLI access keys: requests one key may make per minute.
# API_RATE_LIMIT=120
# Batch import mode: smallest sheet (rows) that goes to Shopify as one bulk job.
# BATCH_MIN_ITEMS=50

# Email alerts (optional): an SMTP account to send from, and the From line.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Bulkport <alerts@example.com>

# Google Drive backup copies (optional): an OAuth client from Google Cloud,
# with <app address>/google/callback as its redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
